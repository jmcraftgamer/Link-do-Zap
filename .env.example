# Configuracao do backend na VPS.
# Copie para /opt/assistente-zap/.env e ajuste. Nunca versione este arquivo.

# Onde o bot guarda dados (zaps.json, contatos, sessoes do WhatsApp).
DATA_DIR=/opt/assistente-zap/data

# Interface/porta da API. Com Nginx na frente, mantenha 127.0.0.1.
# Para acessar direto pelo IP (sem Nginx), use HOST=0.0.0.0 e libere a porta.
HOST=127.0.0.1
PORT=3000

# Prefixo das rotas da API
API_PREFIX=/api/v1

# Senha administrativa do painel. Se vazio, uma senha aleatoria e gerada no
# primeiro boot e gravada em data/ADMIN_PASSWORD.txt.
ADMIN_PASSWORD=

# Segredo dos tokens (deixe vazio para gerar e guardar em backend-auth.json).
# Em producao prefira definir um valor fixo e aleatorio (ex.: openssl rand -hex 32).
JWT_SECRET=

# Validade do token de login, em segundos (padrao: 7 dias).
TOKEN_TTL_SECONDS=604800

# Origens permitidas no CORS. Use * apenas enquanto for HTTP por IP.
CORS_ORIGINS=*

# Limite de upload por requisicao (MB).
MAX_BODY_MB=30

# Desligue a sincronizacao do modo "repositorio de dados" no servidor.
LINK_SERVER_SYNC=0
HEADLESS=1

# Fuso horario do processo (vencimento, carencia e agendamentos).
TZ=America/Sao_Paulo

# Pareamento automatico: gera o codigo no painel e grava em data/pairing-codes.json.
# Coloque 0 se preferir parear manualmente pelo QR.
LINK_AUTO_PAIR=1

# Frase do backup criptografado. O install.sh gera uma automaticamente e agenda
# o backup diario as 03:00. Guarde FORA da VPS: sem ela o backup nao restaura.
BACKUP_PASSPHRASE=

# ---------------------------------------------------------------
# Capacidade (30 Zaps numa VPS de 12 GB)
# ---------------------------------------------------------------

# Quantos Chromium podem subir ao mesmo tempo. Cada Zap abre um navegador
# proprio; sem limite, o boot abre todos juntos e estoura a RAM.
LINK_CONNECT_CONCURRENCY=2
# Intervalo minimo entre dois inicios de Chromium (ms).
LINK_CONNECT_GAP_MS=2000

# Reciclagem noturna: reconecta 1 Zap por vez para devolver a RAM que o
# WhatsApp Web acumula em dias. A sessao e preservada (nao re-pareia).
# Hora local (0-23). Use "off" para desativar.
LINK_RECYCLE_HOUR=4
# Intervalo entre um Zap e o proximo na reciclagem (ms). 30 Zaps ~ 1 hora.
LINK_RECYCLE_GAP_MS=120000

# Transcricao de audio: quantos audios sobem para a IA ao mesmo tempo.
# Cada audio vira um upload de alguns MB; sem limite, 30 audios simultaneos
# empilham 30 corpos de requisicao na RAM.
LINK_TRANSCRIBE_CONCURRENCY=2
# Tempo maximo por tentativa de transcricao (ms). Estourou, cai para o
# proximo provedor da lista em vez de deixar a conversa pendurada.
LINK_TRANSCRIBE_TIMEOUT_MS=60000
