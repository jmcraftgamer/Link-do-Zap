{
  "name": "link-no-whatsapp",
  "version": "1.0.0",
  "description": "Link no WhatsApp - Gerencie seus Zaps com assistentes de IA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "start:headless": "electron . --no-sandbox --disable-gpu --disable-dev-shm-usage",
    "start:linux": "xvfb-run -a electron . --no-sandbox --disable-gpu --disable-dev-shm-usage",
    "test": "node test/run.js && node test/ai.js && node test/flow.js && node test/linux.js && node test/auto-msg.js && node test/agent.js",
    "test:ai": "node test/ai.js",
    "test:agent": "node test/agent.js",
    "test:ai-live": "node test/ai-live.js",
    "test:flow": "node test/flow.js",
    "test:linux": "node test/linux.js"
  },
  "author": "Link no WhatsApp",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "wwebjs-electron": "^1.34.7"
  }
}
